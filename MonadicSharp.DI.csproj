<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <PackageId>MonadicSharp.DI</PackageId>
    <Version>1.1.0</Version>
    <Authors>Danny4897</Authors>
    <Description>Lightweight functional mediator for .NET — CQRS pattern aligned with MonadicSharp primitives (Result&lt;T&gt;, Option&lt;T&gt;, Unit). Supports pipeline behaviors, assembly scanning, and standalone (no-container) mode.</Description>
    <PackageTags>mediator;cqrs;functional;result;monadic;railway-oriented-programming;dependency-injection;mediatR-alternative</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Danny4897/MonadicSharp.DI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Danny4897/MonadicSharp.DI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="MonadicSharp" Version="1.4.0" />
  </ItemGroup>

</Project>
